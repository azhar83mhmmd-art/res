# 1. Rename file ini "$ mv .env.example .env"
# 2. Atur PORT, CONFIG bebas mau gimana
# 3. Ambil apikey/token upstash redis di website https://upstash.com

# port terserah
PORT=8268

# config rate limiter
# Rate limit max: 15/req
# Rate limit window: 1 detik/req
# Rate limit banned: 1 menit/ip
RATE_LIMIT_MAX_REQUESTS=15
RATE_LIMIT_WINDOW=1000
RATE_LIMIT_BAN_TIME=60000

# upstash redis: upstash.com
# PENTING: isi dengan URL/token ASLI dari dashboard Upstash-mu, jangan
# ditinggal contoh seperti "https://xxxx.upstash.io" - nilai placeholder
# akan otomatis dianggap "belum dikonfigurasi" dan rate limiter memakai
# fallback memory (bukan error/crash, tapi Redis tidak aktif).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 4. Server Monitor (opsional) - fitur /monitor butuh Supabase.
#    Kalau kosong, /monitor tetap jalan tapi menampilkan status
#    "unavailable" (bukan data palsu).
#    Buat project di https://supabase.com lalu jalankan supabase/schema.sql
#    di SQL Editor. SERVICE_ROLE_KEY didapat dari Project Settings > API.
#    Isi dengan URL project ASLI (https://xxxxxxxx.supabase.co), jangan
#    ditinggal contoh - nilai placeholder dianggap belum dikonfigurasi.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt untuk hash IP (statistik unique users di /monitor).
# Boleh diisi string acak apa saja, cukup konsisten antar deploy.
MONITOR_IP_SALT=

# Opsional: API key OCR.space sendiri untuk endpoint /api/ai/ocr
# (kalau kosong, memakai demo key publik dengan kuota terbatas).
OCR_SPACE_API_KEY=
